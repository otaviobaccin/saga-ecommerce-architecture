digraph G {
 graph [label="SAGA ORQUESTRADA | E-COMMERCE",labelloc=t,fontsize=23,fontname="DejaVu Sans",bgcolor="#f8fafc",pad=.35,ranksep=.75,nodesep=.42];
 node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=12,penwidth=1.3,color="#cbd5e1",fillcolor="white",margin=".20,.14"];
 edge [fontname="DejaVu Sans",fontsize=10,color="#475569",arrowsize=.75];
 client [label="Cliente / Checkout",fillcolor="#dbeafe"];
 api [label="API / Checkout",fillcolor="#dbeafe"];
 orchestrator [label="Saga Orchestrator\nMáquina de estados + timers",fillcolor="#bfdbfe",color="#2563eb"];
 saga_db [label="Saga DB\nEstados, passos, prazos",shape=cylinder,fillcolor="#dbeafe"];
 broker [label="Message Broker\nComandos / respostas / eventos",fillcolor="#fde68a",color="#d97706"];
 order [label="Order Service\nCriar / Confirmar / Cancelar",fillcolor="#ccfbf1"];
 inventory [label="Inventory Service\nReservar / Liberar",fillcolor="#ccfbf1"];
 payment [label="Payment Service\nAutorizar / Consultar status",fillcolor="#ccfbf1"];
 order_db [label="Order DB",shape=cylinder]; inventory_db [label="Inventory DB",shape=cylinder]; payment_db [label="Payment DB",shape=cylinder]; gateway [label="Gateway externo\nPagamento",fillcolor="#f1f5f9"];
 dlq [label="DLQ + Alertas\nInspeção e replay controlado",fillcolor="#fecaca"];
 client -> api [label="POST /checkout"];
 api -> orchestrator [label="inicia saga"];
 orchestrator -> saga_db [label="persiste progresso",dir=both];
 orchestrator -> broker [label="publica comandos",dir=both];
 broker -> order [label="comandos / respostas",dir=both];
 broker -> inventory [label="comandos / respostas",dir=both];
 broker -> payment [label="comandos / respostas",dir=both];
 order -> order_db; inventory -> inventory_db; payment -> payment_db; payment -> gateway [label="API + chave idempotente",dir=both]; broker -> dlq [label="falhas esgotadas"];
 {rank=same;order;inventory;payment}
 {rank=same;order_db;inventory_db;payment_db}
}
