digraph G {
graph [label="SEQUÊNCIA | PAGAMENTO RECUSADO",labelloc=t,fontsize=21,fontname="DejaVu Sans",bgcolor="#f8fafc",pad=.25,ranksep=.40,nodesep=.14];
node [shape=box,style="rounded,filled",fontname="DejaVu Sans",fontsize=10,fillcolor="#eff6ff",color="#94a3b8",margin=".11,.10"];
edge [fontname="DejaVu Sans",fontsize=9,color="#334155",arrowsize=.6];
a0 [label="Cliente",group="g0",fillcolor="#bfdbfe",color="#2563eb"];
a1 [label="Orchestrator",group="g1",fillcolor="#bfdbfe",color="#2563eb"];
a2 [label="Order",group="g2",fillcolor="#bfdbfe",color="#2563eb"];
a3 [label="Inventory",group="g3",fillcolor="#bfdbfe",color="#2563eb"];
a4 [label="Payment",group="g4",fillcolor="#bfdbfe",color="#2563eb"];
a5 [label="Broker",group="g5",fillcolor="#bfdbfe",color="#2563eb"];
{rank=same;a0;a1;a2;a3;a4;a5;}
s0 [label="01. Checkout inicia Saga",fillcolor="#ffffff",color="#cbd5e1"];
a0 -> s0 [style=dotted,arrowhead=none,constraint=false];
s0 -> a1 [style=solid,constraint=false];
s1 [label="02. CreateOrder -> PENDING",fillcolor="#ffffff",color="#cbd5e1"];
a1 -> s1 [style=dotted,arrowhead=none,constraint=false];
s1 -> a2 [style=dashed,constraint=false];
s0 -> s1 [style=invis,weight=100];
s2 [label="03. OrderCreated",fillcolor="#ffffff",color="#cbd5e1"];
a2 -> s2 [style=dotted,arrowhead=none,constraint=false];
s2 -> a1 [style=dashed,constraint=false];
s1 -> s2 [style=invis,weight=100];
s3 [label="04. ReserveStock",fillcolor="#ffffff",color="#cbd5e1"];
a1 -> s3 [style=dotted,arrowhead=none,constraint=false];
s3 -> a3 [style=dashed,constraint=false];
s2 -> s3 [style=invis,weight=100];
s4 [label="05. StockReserved",fillcolor="#ffffff",color="#cbd5e1"];
a3 -> s4 [style=dotted,arrowhead=none,constraint=false];
s4 -> a1 [style=dashed,constraint=false];
s3 -> s4 [style=invis,weight=100];
s5 [label="06. AuthorizePayment",fillcolor="#ffffff",color="#cbd5e1"];
a1 -> s5 [style=dotted,arrowhead=none,constraint=false];
s5 -> a4 [style=dashed,constraint=false];
s4 -> s5 [style=invis,weight=100];
s6 [label="07. PaymentDeclined (falha definitiva)",fillcolor="#fee2e2",color="#dc2626"];
a4 -> s6 [style=dotted,arrowhead=none,constraint=false];
s6 -> a1 [style=solid,constraint=false];
s5 -> s6 [style=invis,weight=100];
s7 [label="08. ReleaseStock (compensação)",fillcolor="#fee2e2",color="#dc2626"];
a1 -> s7 [style=dotted,arrowhead=none,constraint=false];
s7 -> a3 [style=solid,constraint=false];
s6 -> s7 [style=invis,weight=100];
s8 [label="09. StockReleased (idempotente)",fillcolor="#fee2e2",color="#dc2626"];
a3 -> s8 [style=dotted,arrowhead=none,constraint=false];
s8 -> a1 [style=solid,constraint=false];
s7 -> s8 [style=invis,weight=100];
s9 [label="10. CancelOrder (compensação)",fillcolor="#fee2e2",color="#dc2626"];
a1 -> s9 [style=dotted,arrowhead=none,constraint=false];
s9 -> a2 [style=solid,constraint=false];
s8 -> s9 [style=invis,weight=100];
s10 [label="11. OrderCancelled",fillcolor="#fee2e2",color="#dc2626"];
a2 -> s10 [style=dotted,arrowhead=none,constraint=false];
s10 -> a1 [style=solid,constraint=false];
s9 -> s10 [style=invis,weight=100];
s11 [label="12. Saga COMPENSATED / pedido CANCELLED",fillcolor="#dcfce7",color="#cbd5e1"];
a1 -> s11 [style=dotted,arrowhead=none,constraint=false];
s11 -> a0 [style=solid,constraint=false];
s10 -> s11 [style=invis,weight=100];
}
